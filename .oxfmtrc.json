{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "logs",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "lerna-debug.log*",
    "tailwindcss-animate.css",
    "dist",
    "dist-ssr",
    "node_modules",
    "public",
    "*.local",
    ".vscode/*",
    "!.vscode/extensions.json",
    "!.vscode/launch.json",
    "!.vscode/settings.json",
    "!.vscode/tasks.json",
    ".idea",
    ".DS_Store",
    "*.suo",
    "*.ntvs*",
    "*.njsproj",
    "*.sln",
    "*.sw?",
    ".expo/",
    "dist/",
    "web-build/",
    "expo-env.d.ts",
    ".kotlin/",
    "*.orig.*",
    "*.jks",
    "*.p8",
    "*.p12",
    "*.key",
    "*.mobileprovision",
    ".metro-health-check*",
    ".DS_Store",
    "*.pem",
    ".env",
    ".env*.local",
    ".env*.prod",
    "*.tsbuildinfo",
    "/ios",
    "/android",
    "/generated",
    "/prisma",
    ".agents",
    "skills-lock.json",
    ".node-version",
    "src/uniwind-types.d.ts"
  ]
}
